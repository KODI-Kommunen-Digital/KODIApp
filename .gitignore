# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
android/app/build/

# Env files (never commit — obtain from the team password manager)
assets/env/staging/.envGera
assets/env/production/.envGera

# Firebase configuration (auto-generated by Firebase CLI — do not commit)
lib/src/production/firebase_options.dart
lib/src/staging/firebase_options.dart
android/app/src/production/google-services.json
android/app/src/staging/google-services.json
ios/GoogleService-Info.plist
ios/Runner/GoogleService-Info.plist
ios/Runner/config/production/GoogleService-Info.plist
ios/Runner/config/staging/GoogleService-Info.plist

# Android signing credentials (never commit)
android/app/upload-keystore-app.jks
android/key.properties

# FVM Version Cache
.fvm/