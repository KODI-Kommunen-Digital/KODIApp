<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB"
          version="3.0"
          toolsVersion="18122"
          targetRuntime="iOS.CocoaTouch"
          propertyAccessControl="none"
          useAutolayout="YES"
          launchScreen="YES">
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="12089"/>
    </dependencies>
    <scenes>
        <!-- Empty View Controller -->
        <scene sceneID="0">
            <objects>
                <viewController id="emptyLaunchVC" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="emptyView">
                        <rect key="frame" x="0.0" y="0.0" width="1" height="1"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleToFill" image="LaunchBackground" translatesAutoresizingMaskIntoConstraints="NO" id="launchBackgroundImageView">
                            </imageView>
                        </subviews>
                        <color key="backgroundColor" red="1" green="1" blue="1" alpha="0.0" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="launchBackgroundImageView" firstAttribute="leading" secondItem="emptyView" secondAttribute="leading" id="constraint1"/>
                            <constraint firstAttribute="trailing" secondItem="launchBackgroundImageView" secondAttribute="trailing" id="constraint2"/>
                            <constraint firstItem="launchBackgroundImageView" firstAttribute="top" secondItem="emptyView" secondAttribute="top" id="constraint3"/>
                            <constraint firstAttribute="bottom" secondItem="launchBackgroundImageView" secondAttribute="bottom" id="constraint4"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="firstResponder" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchBackground" width="1" height="1"/>
    </resources>
</document>